generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model cache {
  key        String @id @db.VarChar(255)
  value      String
  expiration Int

  @@index([expiration], map: "cache_expiration_index")
}

model cache_locks {
  key        String @id @db.VarChar(255)
  owner      String @db.VarChar(255)
  expiration Int

  @@index([expiration], map: "cache_locks_expiration_index")
}

model device_verification_tokens {
  id          BigInt    @id @default(autoincrement())
  user_id     BigInt
  fingerprint String    @db.VarChar(255)
  token       String    @unique(map: "device_verification_tokens_token_unique") @db.VarChar(255)
  ip_address  String    @db.VarChar(255)
  user_agent  String
  expires_at  DateTime  @db.Timestamp(0)
  used_at     DateTime? @db.Timestamp(0)
  created_at  DateTime? @db.Timestamp(0)
  updated_at  DateTime? @db.Timestamp(0)
  users       users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "device_verification_tokens_user_id_foreign")
}

model device_verifications {
  id           BigInt    @id @default(autoincrement())
  user_id      BigInt
  fingerprint  String    @db.VarChar(255)
  ip_address   String?   @db.VarChar(255)
  user_agent   String?   @db.VarChar(255)
  device_name  String?   @db.VarChar(255)
  platform     String?   @db.VarChar(255)
  browser      String?   @db.VarChar(255)
  is_verified  Boolean   @default(false)
  verified_at  DateTime? @db.Timestamp(0)
  last_used_at DateTime? @db.Timestamp(0)
  created_at   DateTime? @db.Timestamp(0)
  updated_at   DateTime? @db.Timestamp(0)
  code         String
  users        users     @relation(fields: [user_id], references: [id])

  @@unique([user_id, fingerprint], map: "device_verifications_user_id_fingerprint_unique")
  @@index([fingerprint], map: "device_verifications_fingerprint_index")
}

model devices {
  id                      BigInt    @id @default(autoincrement())
  user_id                 BigInt
  fingerprint             String?   @db.VarChar(255)
  browser                 String?   @db.VarChar(255)
  ip_address              String?   @db.VarChar(255)
  verification_token      String?   @db.VarChar(255)
  verified_at             DateTime? @db.Timestamp(0)
  created_at              DateTime? @db.Timestamp(0)
  updated_at              DateTime? @db.Timestamp(0)
  last_active_at          DateTime? @db.Timestamp(0)
  os                      String?   @db.VarChar(255)
  trust_token             String?   @db.VarChar(64)
  session_id              String?   @db.VarChar(255)
  logged_out_at           DateTime? @db.Timestamp(0)
  platform                String?   @db.VarChar(255)
  hardware_signature      String?
  device_name             String?   @db.VarChar(255)
  verification_expires_at DateTime? @db.Timestamp(0)
  users                   users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "devices_user_id_foreign")

  @@index([fingerprint], map: "devices_fingerprint_index")
  @@index([session_id], map: "devices_session_id_index")
}

model email_verifications {
  id         BigInt    @id @default(autoincrement())
  email      String    @db.VarChar(255)
  token      String    @db.VarChar(255)
  created_at DateTime? @db.Timestamp(0)

  @@index([email], map: "email_verifications_email_index")
}

model failed_jobs {
  id         BigInt   @id @default(autoincrement())
  uuid       String   @unique(map: "failed_jobs_uuid_unique") @db.VarChar(255)
  connection String
  queue      String
  payload    String
  exception  String
  failed_at  DateTime @default(now()) @db.Timestamp(0)
}

model job_batches {
  id             String  @id @db.VarChar(255)
  name           String  @db.VarChar(255)
  total_jobs     Int
  pending_jobs   Int
  failed_jobs    Int
  failed_job_ids String
  options        String?
  cancelled_at   Int?
  created_at     Int
  finished_at    Int?
}

model jobs {
  id           BigInt @id @default(autoincrement())
  queue        String @db.VarChar(255)
  payload      String
  attempts     Int    @db.SmallInt
  reserved_at  Int?
  available_at Int
  created_at   Int

  @@index([queue], map: "jobs_queue_index")
}

model migrations {
  id        Int    @id @default(autoincrement())
  migration String @db.VarChar(255)
  batch     Int
}

model notifications {
  id         BigInt    @id @default(autoincrement())
  user_id    BigInt
  type       String    @default("system") @db.VarChar(255)
  title      String    @db.VarChar(255)
  message    String
  data       Json?     @db.Json
  read_at    DateTime? @db.Timestamp(0)
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "notifications_user_id_foreign")

  @@index([type], map: "notifications_type_index")
  @@index([user_id, read_at], map: "notifications_user_id_read_at_index")
}

model password_reset_tokens {
  email      String    @id @db.VarChar(255)
  token      String    @db.VarChar(255)
  created_at DateTime? @db.Timestamp(0)
}

model personal_access_tokens {
  id             BigInt    @id @default(autoincrement())
  tokenable_type String    @db.VarChar(255)
  tokenable_id   BigInt
  name           String
  token          String    @unique(map: "personal_access_tokens_token_unique") @db.VarChar(64)
  abilities      String?
  last_used_at   DateTime? @db.Timestamp(0)
  expires_at     DateTime? @db.Timestamp(0)
  created_at     DateTime? @db.Timestamp(0)
  updated_at     DateTime? @db.Timestamp(0)

  @@index([expires_at], map: "personal_access_tokens_expires_at_index")
  @@index([tokenable_type, tokenable_id], map: "personal_access_tokens_tokenable_type_tokenable_id_index")
}

model push_subscriptions {
  id         BigInt    @id @default(autoincrement())
  user_id    BigInt
  endpoint   String
  public_key String
  auth_token String
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "push_subscriptions_user_id_foreign")
}

model security_logs {
  id         BigInt    @id @default(autoincrement())
  user_id    BigInt?
  event      String    @db.VarChar(255)
  ip_address String    @db.Inet
  user_agent String?
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
}

model sessions {
  id            String  @id @db.VarChar(255)
  user_id       BigInt?
  ip_address    String? @db.VarChar(45)
  user_agent    String?
  payload       String
  last_activity Int

  @@index([last_activity], map: "sessions_last_activity_index")
  @@index([user_id], map: "sessions_user_id_index")
}

model trusted_devices {
  id                 BigInt    @id @default(autoincrement())
  user_id            BigInt
  device_fingerprint String    @db.VarChar(255)
  ip_address         String?   @db.VarChar(255)
  user_agent         String?
  device_name        String?   @db.VarChar(255)
  last_login_at      DateTime  @default(now()) @db.Timestamp(0)
  created_at         DateTime? @db.Timestamp(0)
  updated_at         DateTime? @db.Timestamp(0)
  users              users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "trusted_devices_user_id_foreign")

  @@unique([user_id, device_fingerprint], map: "trusted_devices_user_id_device_fingerprint_unique")
  @@index([user_id, last_login_at], map: "trusted_devices_user_id_last_login_at_index")
}

model user_devices {
  id               BigInt    @id @default(autoincrement())
  user_id          BigInt
  device_token     String    @unique(map: "user_devices_device_token_unique") @db.Uuid
  fingerprint      String    @db.VarChar(255)
  name             String?   @db.VarChar(255)
  platform         String?   @db.VarChar(255)
  browser          String?   @db.VarChar(255)
  type             String?   @db.VarChar(255)
  browser_version  String?   @db.VarChar(255)
  ip_address       String    @db.VarChar(255)
  location         Json?     @db.Json
  is_trusted       Boolean   @default(false)
  verified_at      DateTime? @db.Timestamp(0)
  last_login_at    DateTime? @db.Timestamp(0)
  last_activity_at DateTime? @db.Timestamp(0)
  logged_out_at    DateTime? @db.Timestamp(0)
  created_at       DateTime? @db.Timestamp(0)
  updated_at       DateTime? @db.Timestamp(0)
  deleted_at       DateTime? @db.Timestamp(0)
  session_id       String?   @db.VarChar(255)
  users            users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "user_devices_user_id_foreign")

  @@unique([user_id, device_token], map: "user_devices_user_id_device_token_unique")
  @@index([fingerprint])
  @@index([fingerprint], map: "user_devices_fingerprint_index")
  @@index([user_id])
  @@index([user_id], map: "user_devices_user_id_index")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model users {
  id                            BigInt                       @id @default(autoincrement())
  fullname                      String?                      @db.VarChar(255)
  username                      String                       @unique(map: "users_username_unique") @db.VarChar(255)
  email                         String                       @unique(map: "users_email_unique") @db.VarChar(255)
  email_verified_at             DateTime?                    @db.Timestamp(0)
  password                      String                       @db.VarChar(255)
  country                       String?                      @db.VarChar(255)
  country_code                  String?                      @db.VarChar(10)
  mobile_code                   String?                      @db.VarChar(10)
  avatar                        String?                      @db.VarChar(255)
  business_name                 String?                      @db.VarChar(255)
  completed_trade               Int                          @default(0)
  rating                        Float                        @default(0) @db.Real
  is_verified                   Boolean                      @default(false)
  remember_token                String?                      @db.VarChar(100)
  created_at                    DateTime?                    @db.Timestamp(0)
  updated_at                    DateTime?                    @db.Timestamp(0)
  entity_type                   String?                      @db.Char(255)
  email_verification_token      String?                      @db.VarChar(64)
  email_verification_expires_at DateTime?                    @db.Timestamp(0)
  accounttype                   String                       @default("individual") @db.VarChar(255)
  email_otp                     String?                      @db.VarChar(255)
  email_otp_expires_at          DateTime?                    @db.Timestamp(0)
  email_otp_attempts            Int                          @default(0) @db.SmallInt
  email_otp_last_sent_at        DateTime?                    @db.Timestamp(0)
  account_locked_until          DateTime?                    @db.Timestamp(0)
  email_otp_blocked_until       DateTime?                    @db.Timestamptz(0)
  email_otp_resend_attempts     Int                          @default(0)
  two_factor_secret             String?
  two_factor_enabled            Boolean                      @default(false)
  two_factor_confirmed_at       DateTime?                    @db.Timestamp(0)
  session_id                    String?                      @db.VarChar(255)
  login_attempts                Int                          @default(0) @db.SmallInt
  login_locked_until            DateTime?                    @db.Timestamp(0)
  last_login_attempt_at         DateTime?                    @db.Timestamp(0)
  timezone                      String                       @default("UTC") @db.VarChar(255)
  last_activity_at              DateTime?                    @db.Timestamp(0)
  password_reset_expires_at     DateTime?                    @db.Timestamp(0)
  password_reset_code           String?                      @db.VarChar(255)
  device_verification_tokens    device_verification_tokens[]
  device_verifications          device_verifications[]
  devices                       devices[]
  notifications                 notifications[]
  oauth_providers               oauth_providers[]
  push_subscriptions            push_subscriptions[]
  store                         store[]
  trusted_devices               trusted_devices[]
  user_devices                  user_devices[]
  wallets                       wallets?

  @@index([accounttype], map: "idx_users_accounttype")
  @@index([email], map: "idx_users_email")
  @@index([email, email_verified_at], map: "idx_users_email_verified")
  @@index([username], map: "idx_users_username")
  @@index([session_id], map: "users_session_id_index")
}

model login_blocks {
  id            BigInt    @id @default(autoincrement())
  fingerprint   String    @unique
  attempts      Int       @default(0)
  blocked_until DateTime?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
  ip_address    String?
}

model wallets {
  id         BigInt    @id @default(autoincrement())
  user_id    BigInt    @unique
  balance    Float     @default(0)
  currency   String    @default("USDDC") @db.VarChar(5)
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "1")
}

model oauth_providers {
  id            BigInt    @id @default(autoincrement())
  user_id       BigInt
  provider      String    @db.VarChar(50)
  provider_id   String    @db.VarChar(255)
  access_token  String?
  refresh_token String?
  expires_at    DateTime? @db.Timestamp(0)
  profile_data  Json?     @db.Json
  created_at    DateTime? @db.Timestamp(0)
  updated_at    DateTime? @db.Timestamp(0)
  users         users     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([provider, provider_id])
  @@index([user_id])
}

// schema.prisma

model store {
  name                String
  slug                String                 @unique
  customDomain        String?                @unique
  logo                String?
  currency            String                 @default("USD")
  ownerId             BigInt
  createdAt           DateTime               @default(now())
  updatedAt           DateTime
  status              BigInt                 @default(1)
  id                  BigInt                 @id @default(autoincrement())
  description         String?
  menus               StoreMenu[]
  pages               StorePage[]
  theme               StoreTheme?
  sections            ThemeSection[]
  products            Product[]
  productTypes        ProductType[]
  tags                Tag[]
  collections         Collection[]
  orders              Order[]
  paymentTransactions PaymentTransaction[]
  paymentProviders    StorePaymentProvider[]

  users users @relation(fields: [ownerId], references: [id])
}

model StoreTheme {
  id         BigInt   @id @default(autoincrement())
  store_id   BigInt   @unique
  menu_id    BigInt?
  store      store    @relation(fields: [store_id], references: [id])
  colors     Json     @default("{}")
  typography Json     @default("{}")
  header     Json     @default("{}")
  footer     Json     @default("{}")
  settings   Json?
  content    Json?
  created_at DateTime @default(now()) @db.Timestamp(6)
  updated_at DateTime @default(now()) @db.Timestamp(6)
}

model ThemeSection {
  id         BigInt   @id @default(autoincrement())
  store_id   BigInt
  store      store    @relation(fields: [store_id], references: [id], onDelete: Cascade)
  type       String
  name       String
  settings   Json     @default("{}")
  blocks     Json     @default("[]")
  sort_order Int      @default(0)
  is_active  Boolean  @default(true)
  page_type  String   @default("home")
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([store_id, page_type, sort_order])
}

model StorePage {
  title      String
  slug       String
  type       PageType @default(STANDARD)
  content    String?
  image_url  String?
  is_active  Boolean  @default(true)
  sort_order Int      @default(0)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  id         BigInt   @id @default(autoincrement())
  store_id   BigInt
  store      store    @relation(fields: [store_id], references: [id])

  @@unique([store_id, slug])
}

model StoreMenu {
  name     String
  id       BigInt     @id @default(autoincrement())
  store_id BigInt
  handle   String     @unique
  items    MenuItem[]
  store    store      @relation(fields: [store_id], references: [id])
}

model MenuItem {
  title       String
  url         String
  sort_order  Int          @default(0)
  id          BigInt       @id @default(autoincrement())
  menu_id     BigInt
  parent_id   BigInt?
  resource_id BigInt?
  type        MenuItemType
  menu        StoreMenu    @relation(fields: [menu_id], references: [id])
  parent      MenuItem?    @relation("MenuTree", fields: [parent_id], references: [id])
  children    MenuItem[]   @relation("MenuTree")
}

enum PageType {
  STANDARD
  PRODUCT_WITH_HERO
  PRODUCT_WITHOUT_HERO
}

enum MenuItemType {
  HOME
  SEARCH
  COLLECTION
  PRODUCT
  PAGE
  BLOG
  POLICY
  ORDERS
  PROFILE
  CUSTOM
}

model StoreThemePublished {
  id       BigInt @id @default(autoincrement())
  store_id BigInt @unique

  theme    Json
  sections Json
  menus    Json

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
  UNLISTED
}

model Product {
  id BigInt @id @default(autoincrement())

  store_id BigInt

  title  String
  handle String

  description String?

  status ProductStatus @default(DRAFT)

  product_type_id BigInt?

  category String?

  charge_tax Boolean @default(true)

  seo_title String?
  seo_desc  String?

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  store store @relation(fields: [store_id], references: [id], onDelete: Cascade)

  productType ProductType? @relation(fields: [product_type_id], references: [id])

  images      ProductImage[]
  variants    ProductVariant[]
  options     ProductOption[]
  tags        ProductTag[]
  collections ProductCollection[]

  @@unique([store_id, handle])
  @@index([store_id])
  @@index([status])
  @@index([product_type_id])
  @@index([deleted_at])
}

model ProductType {
  id       BigInt @id @default(autoincrement())
  store_id BigInt
  name     String

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  store    store     @relation(fields: [store_id], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([store_id, name])
  @@index([store_id])
}

model Tag {
  id       BigInt @id @default(autoincrement())
  store_id BigInt
  name     String

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  store    store        @relation(fields: [store_id], references: [id], onDelete: Cascade)
  products ProductTag[]

  @@unique([store_id, name])
  @@index([store_id])
}

model ProductTag {
  product_id BigInt
  tag_id     BigInt

  product Product @relation(fields: [product_id], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tag_id], references: [id], onDelete: Cascade)

  @@id([product_id, tag_id])
  @@index([tag_id])
}

model ProductImage {
  id BigInt @id @default(autoincrement())

  product_id BigInt

  url String
  key String? // ← جديد: مسار R2 للحذف
  alt String?

  position Int @default(0)

  created_at DateTime @default(now())

  product Product @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@index([product_id])
}

model ProductOption {
  id BigInt @id @default(autoincrement())

  product_id BigInt

  name String

  position Int @default(0)

  product Product @relation(fields: [product_id], references: [id], onDelete: Cascade)

  colors Json?

  display_type String?

  values ProductOptionValue[]

  @@index([product_id])
}

model ProductOptionValue {
  id BigInt @id @default(autoincrement())

  option_id BigInt

  value String

  option ProductOption @relation(fields: [option_id], references: [id], onDelete: Cascade)

  @@index([option_id])
}

model ProductVariant {
  id BigInt @id @default(autoincrement())

  product_id BigInt

  title String

  price            Decimal? @db.Decimal(10, 2)
  compare_at_price Decimal? @db.Decimal(10, 2)
  cost_per_item    Decimal? @db.Decimal(10, 2)

  sku     String?
  barcode String?

  inventory_qty Int @default(0)

  track_inventory  Boolean @default(true)
  continue_selling Boolean @default(false)

  option1 String?
  option2 String?
  option3 String?

  image_url String?
  image_key String?

  image_id BigInt?

  position Int @default(0)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  product Product @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@index([product_id])
  @@index([sku])
}

model Upload {
  id            BigInt   @id @default(autoincrement())
  key           String   @unique
  url           String
  mime_type     String
  size          Int
  store_id      BigInt
  status        String   @default("pending") // pending | attached
  attached_type String? // "product" | "variant"
  attached_id   BigInt?
  created_at    DateTime @default(now())

  @@index([status, created_at])
  @@index([store_id])
}

model Collection {
  id          Int     @id @default(autoincrement())
  name        String
  handle      String
  description String?
  image_url   String?
  image_key   String?

  seo_title       String?
  seo_description String?

  storeId BigInt

  store store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  products ProductCollection[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, handle])
}

model ProductCollection {
  productId    BigInt
  collectionId Int
  position     Int    @default(0)

  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([productId, collectionId])
}

enum OrderStatus {
  PENDING // لسه جديد، محتاج التاجر يراجعه
  CONFIRMED // التاجر أكد الطلب
  PROCESSING // بيتجهز
  SHIPPED // اتشحن
  DELIVERED // وصل
  CANCELLED // اتلغى
}

// جاهزة لبوابات الدفع اللي هتضيفها بعدين — دلوقتي كل الطلبات هتتعمل
// بحالة UNPAID لحد ما تضيف منطق الدفع الفعلي.
enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
  FAILED
}

model Order {
  id BigInt @id @default(autoincrement())

  // العلاقات
  store_id BigInt
  store    store  @relation(fields: [store_id], references: [id], onDelete: Cascade)

  // رقم الطلب الظاهر للعميل
  order_number String

  // حالة الطلب
  status OrderStatus @default(PENDING)

  // ملخص سريع لحالة الدفع (الحقيقة ستكون داخل PaymentTransaction)
  payment_status PaymentStatus @default(UNPAID)

  // آخر وسيلة دفع استخدمها العميل
  payment_method PaymentProviderKey?

  // هل تم الدفع؟
  paid_at DateTime?

  // بيانات العميل
  customer_name  String
  customer_phone String
  customer_email String?

  // العنوان
  address_line String
  city         String
  notes        String?

  // الأسعار
  subtotal Decimal @db.Decimal(10, 2)
  total    Decimal @db.Decimal(10, 2)

  // المنتجات
  items OrderItem[]

  // جميع محاولات الدفع الخاصة بالطلب
  transactions PaymentTransaction[]

  // التواريخ
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([store_id, order_number])
  @@index([store_id])
  @@index([status])
  @@index([payment_status])
  @@index([created_at])
}

model OrderItem {
  id       BigInt @id @default(autoincrement())
  order_id BigInt
  order    Order  @relation(fields: [order_id], references: [id], onDelete: Cascade)

  // مش هنعمل relation إجباري على Product/ProductVariant عشان لو المنتج
  // اتحذف بعدين، تفاصيل الطلب القديم تفضل زي ما هي
  product_id BigInt?
  variant_id BigInt?

  title         String
  variant_title String?
  price         Decimal @db.Decimal(10, 2)
  qty           Int
  image_url     String?
}

enum PaymentProviderKey {
  cod
  bank_transfer
  paymob
  kashier
  stripe
  fawry
  paypal
  paytabs
  moyasar
  paylink
  tap
  tabby
  taager
  my_fatoorah
  fawaterk
  xpay
  ziina
  tamara
  easykash
  upay
  fabmisr
}

model StorePaymentProvider {
  id       BigInt @id @default(autoincrement())
  store_id BigInt
  store    store  @relation(fields: [store_id], references: [id], onDelete: Cascade)

  provider PaymentProviderKey

  enabled      Boolean @default(false)
  is_test_mode Boolean @default(true)

  // بيانات الاتصال الحساسة (API keys / secrets) — مشفّرة بالكامل (AES-256-GCM)
  // قبل ما تتخزن هنا. أبداً متتخزنش plaintext.
  credentials_encrypted String? @db.Text

  // إعدادات غير حساسة خاصة بالبوابة (مثلاً: بيانات التحويل البنكي، الحد الأدنى للمبلغ...)
  settings Json? @default("{}")

  position Int @default(0)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([store_id, provider])
  @@index([store_id])
}

enum PaymentTransactionStatus {
  CREATED

  PENDING

  WAITING_CUSTOMER

  PROCESSING

  AUTHORIZED

  CAPTURED

  SUCCEEDED

  FAILED

  CANCELLED

  EXPIRED

  PARTIALLY_REFUNDED

  REFUNDED

  CHARGEBACK

  DISPUTED
}

model PaymentTransaction {
  id BigInt @id @default(autoincrement())

  // العلاقات
  store_id BigInt
  order_id BigInt

  store store @relation(fields: [store_id], references: [id], onDelete: Cascade)
  order Order @relation(fields: [order_id], references: [id], onDelete: Cascade)

  // البوابة
  provider PaymentProviderKey

  type PaymentTransactionType @default(PAYMENT)

  // حالة المعاملة
  status PaymentTransactionStatus @default(CREATED)

  // المبلغ
  amount   Decimal @db.Decimal(12, 2)
  currency String  @db.VarChar(10)

  // مرجع داخلي
  merchant_reference String @db.VarChar(255)

  // معرفات البوابة
  gateway_order_id    String?
  gateway_payment_id  String?
  gateway_capture_id  String?
  gateway_reference   String?
  gateway_customer_id String?

  // حماية من تكرار الطلب
  idempotency_key String? @unique

  // لماذا فشلت العملية؟
  failure_code   String?
  failure_reason String?

  // ماذا أرسلنا وماذا رجع؟
  provider_request  Json?
  provider_response Json?

  // بيانات إضافية
  metadata Json?

  // التوقيتات
  verified_at DateTime?
  paid_at     DateTime?
  expires_at  DateTime?
  source      String?
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  // العلاقات
  events       PaymentEvent[]
  refunds      PaymentRefund[]
  webhook_logs PaymentWebhookLog[]

  @@unique([provider, gateway_reference])
  @@index([store_id])
  @@index([order_id])
  @@index([provider])
  @@index([status])
  @@index([store_id, status])
  @@index([order_id, status])
  @@index([created_at])
}

enum PaymentEventType {
  CREATED

  REDIRECTED

  WEBHOOK_RECEIVED

  VERIFIED

  AUTHORIZED

  CAPTURED

  SUCCEEDED

  FAILED

  CANCELLED

  EXPIRED

  REFUND_CREATED

  REFUND_COMPLETED
}

model PaymentEvent {
  id BigInt @id @default(autoincrement())

  transaction_id BigInt

  transaction PaymentTransaction @relation(fields: [transaction_id], references: [id], onDelete: Cascade)

  type    PaymentEventType
  message String?
  payload Json?

  created_at DateTime @default(now())

  @@index([transaction_id])
}

enum RefundStatus {
  PENDING

  SUCCEEDED

  FAILED
}

model PaymentRefund {
  id BigInt @id @default(autoincrement())

  transaction_id BigInt

  transaction PaymentTransaction @relation(fields: [transaction_id], references: [id], onDelete: Cascade)

  amount Decimal @db.Decimal(12, 2)

  reason            String?
  gateway_refund_id String?

  provider_response Json?

  status RefundStatus

  refunded_at DateTime?

  currency String @db.VarChar(10)

  provider PaymentProviderKey

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([transaction_id])
}

model PaymentWebhookLog {
  id BigInt @id @default(autoincrement())

  transaction_id BigInt?

  transaction PaymentTransaction? @relation(fields: [transaction_id], references: [id])

  provider PaymentProviderKey

  event_name String?
  signature  String?

  headers Json?
  payload Json

  processed Boolean @default(false)

  error String?

  received_at  DateTime  @default(now())
  processed_at DateTime?

  provider_event_id String?

  status_code            Int?
  processing_duration_ms Int?

  is_duplicate Boolean @default(false)

  @@index([transaction_id])
  @@index([provider])
  @@index([provider_event_id])
}

enum PaymentTransactionType {
  PAYMENT
  REFUND
  AUTHORIZATION
  CAPTURE
  VOID
}
